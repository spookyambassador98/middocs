# Copy to .env and adjust as needed. docker-compose picks these up automatically.

POSTGRES_USER=mgd
POSTGRES_PASSWORD=mgd_password
POSTGRES_DB=mini_google_docs

JWT_SECRET=change_me_super_secret

# Origin the backend accepts CORS/Socket.io connections from (the frontend's public URL)
CORS_ORIGIN=http://localhost:8080

# Base URL the frontend build embeds to reach the API/WebSocket (nginx load balancer)
VITE_API_URL=http://localhost:8081
